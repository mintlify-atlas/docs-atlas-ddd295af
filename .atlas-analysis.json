  "keyFeatures": [
    "600+ pre-built connectors for APIs, databases, files, and data warehouses",
    "No-code Connector Builder for creating connectors without writing code",
    "Low-code Python CDK for building custom connectors",
    "Change Data Capture (CDC) support for real-time data syncing",
    "Self-hosted (Kubernetes/Docker) and fully-managed Cloud deployment options",
    "Full ELT pipeline management with scheduling, monitoring, and logging",
    "Enterprise features including SSO, RBAC, and audit logging",
    "Native orchestration integrations with Airflow, Prefect, Dagster, and Kestra",
    "PyAirbyte SDK for programmatic pipeline management in Python",
    "MCP server support for AI agent data access"
  ],
  "publicApiSurface": [
    "Config API (REST) — manage sources, destinations, connections, jobs",
    "Airbyte Protocol — open specification for source/destination connectors",
    "PyAirbyte — Python SDK for reading from Airbyte sources",
    "Terraform Provider — infrastructure-as-code for Airbyte resources",
    "MCP Server — AI agent access to Airbyte data pipelines",
    "Connector Builder UI — no-code connector creation interface",
    "Low-code CDK (YAML) — declarative connector definition",
    "Python CDK — programmatic connector authoring in Python"
  ]
}
